<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:Class="Content.Client.Newton.Ports.Jukebox.WhiteJukeboxMenu"
               MinSize="200 300" SetSize="400 400" Name="BoomBoxWindow" Title="Sony D-EJ01">

    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <!-- ▶ -->

        <Label Name="CurrenSongLabel" HorizontalAlignment="Center" HorizontalExpand="True"></Label>

        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Access="Internal" Name="StopButton" Text="◼" HorizontalAlignment="Right"></Button>

            <Button Access="Internal" Name="RepeatButton" Text="♻" HorizontalAlignment="Right" ToggleMode="True"></Button>

            <Button Access="Internal" Name="EjectButton" Text="⏏"></Button>
        </BoxContainer>

        <TabContainer VerticalExpand="True" HorizontalExpand="True">

            <ScrollContainer Name="TapeSongsTab" HScrollEnabled="False">

                <BoxContainer Name="TapeSongsContainer"
                              Orientation="Vertical"
                              Margin="2 2 0 0"
                              HorizontalExpand="True">

                </BoxContainer>

            </ScrollContainer>

        </TabContainer>

    </BoxContainer>

</DefaultWindow>
